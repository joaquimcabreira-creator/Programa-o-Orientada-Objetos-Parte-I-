class Conta {
  private saldo: number = 0;

  depositar(valor: number): void {
    if (valor > 0) {
      this.saldo += valor;
    }
  }

  consultarSaldo(): number {
    return this.saldo;
  }
}

const conta = new Conta();
conta.depositar(167);
console.log(`Saldo atual: R$ ${conta.consultarSaldo().toFixed(2)}`);

